# 飞书 API 配置示例
# 复制此文件为 .env 并填入真实的凭证

# 飞书多维表格信息（可从 URL 中获取）
# 例如：https://my.feishu.cn/base/AUagbEJ3ZadyjwsfjAPcD991nGg?table=tblFXOx2aYXcDLLw&view=vewjPhzV7h
FEISHU_APP_TOKEN=AUagbEJ3ZadyjwsfjAPcD991nGg
FEISHU_TABLE_ID=tblFXOx2aYXcDLLw
FEISHU_VIEW_ID=vewjPhzV7h

# 飞书 OAuth 凭证（推荐，使用与 read_bitable.py 相同的凭证）
# Skill ID: 7605639493156274228
COZE_FEISHU_BITABLE_7605639493156274228=your_oauth_token_here

# 或使用标准飞书 API 访问令牌（如果不需要 OAuth）
# 获取方法：https://open.feishu.cn/document/ukTMukTMukTM/uYjNwUjL2YDM14iN2ATN
# 1. 前往飞书开放平台（https://open.feishu.cn/）
# 2. 创建应用并获取 App ID 和 App Secret
# 3. 使用 App ID 和 App Secret 获取 access_token
#    (建议使用 User Access Token 以便访问你的个人数据)
FEISHU_ACCESS_TOKEN=your_access_token_here

# 注意事项：
# 1. 请勿将 .env 文件提交到版本控制系统
# 2. token 有过期时间，过期后需要重新获取
# 3. 确保 token 有足够权限读取多维表格
# 4. 推荐使用 COZE_FEISHU_BITABLE_* 凭证方式（与 read_bitable.py 一致）
