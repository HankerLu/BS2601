# 飞书 API 配置示例
# 复制此文件为 .env 并填入真实的凭证

# ========================================
# 推荐方式：飞书开放平台 OAuth 2.0
# ========================================
# 使用 app_id 和 app_secret 自动获取访问令牌（推荐）
# 前往 https://open.feishu.cn/ 创建应用获取凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格信息（可从 URL 中获取）
# 例如：https://my.feishu.cn/base/AUagbEJ3ZadyjwsfjAPcD991nGg?table=tblFXOx2aYXcDLLw&view=vewjPhzV7h
FEISHU_APP_TOKEN=AUagbEJ3ZadyjwsfjAPcD991nGg
FEISHU_TABLE_ID=tblFXOx2aYXcDLLw
FEISHU_VIEW_ID=vewjPhzV7h

# ========================================
# 备选方式 1：使用已有的 access_token
# ========================================
# 如果您已经有 access_token，可以直接填入
# 获取方法：https://open.feishu.cn/document/ukTMukTMukTM/uYjNwUjL2YDM14iN2ATN
# FEISHU_OAUTH_ACCESS_TOKEN=your_access_token_here

# ========================================
# 备选方式 2：COZE 方式
# ========================================
# 如果使用 COZE 平台的 Skill 授权
# COZE_FEISHU_BITABLE_7605639493156274228=your_coze_token_here

# ========================================
# 注意事项：
# ========================================
# 1. 请勿将 .env 文件提交到版本控制系统
# 2. 推荐使用飞书开放平台方式（FEISHU_APP_ID + FEISHU_APP_SECRET）
# 3. 确保应用有足够权限读取多维表格
# 4. 如果使用 token 方式，注意 token 的过期时间
